# ==============================================================================
# HerAI Environment Configuration Template (.env.example)
# Note: Keep all AI & private DB keys exclusively on the backend. Never expose to client.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_SECRET_KEY=replace-with-a-secure-random-64-character-secret

# Backend Server (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (PostgreSQL, Auth, RLS)
# Primary source of truth for all users, messages, sessions, memories, and metadata.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-backend-only
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Qdrant Cloud (Rebuildable Vector Database)
# Used for hybrid dense semantic retrieval of conversations and episodic memories.
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_MESSAGES_COLLECTION=herai_messages
QDRANT_MEMORIES_COLLECTION=herai_memories

# Groq AI (Ultra-fast, High-Accuracy Primary Provider)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini AI (Official google-genai SDK Fallback)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Data Processing & Storage Paths (Server Local Scratch for Ingestion)
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js App Router)
# Variables with NEXT_PUBLIC_ are exposed to the browser client.
# Server-only variables remain accessible exclusively in Next.js Server Components.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_DISCLAIMER="HerAI is an AI-generated companion modeled after historical conversation records. It is not an actual human."

# Next.js Server-Side Internal URL (used by Server Components for Docker/local SSR calls to FastAPI)
FASTAPI_INTERNAL_URL=http://backend:8000/api/v1
